# Cloudflare Workers Static Assets のヘッダー設定
# 注意: 複数のルールに一致するとヘッダーが結合される。
# 以前は「/*」の no-store が /assets/* にも結合され、
# 「no-store, ..., max-age=31536000, immutable」という矛盾したヘッダーになっていた（キャッシュされず、圧縮もされない）。
# そのため全体向けの「/*」ルールは置かず、ファイルごとに指定する。

# ハッシュ付きアセットファイル（Viteが生成）- 長期キャッシュ
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 画像などの静的ファイル - 1日キャッシュ（内容を差し替えるときはファイル名を変える）
/images/*
  Cache-Control: public, max-age=86400
/apple/*
  Cache-Control: public, max-age=86400
/google/*
  Cache-Control: public, max-age=86400
/avatar-frames/*
  Cache-Control: public, max-age=86400
/opengraph-image.jpg
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400

# NSFW 判定モデル（大きいので長めにキャッシュ）
/nsfw_model/*
  Cache-Control: public, max-age=604800

# Service Worker は常に最新を取得
/firebase-messaging-sw.js
  Cache-Control: no-cache

# アイコン・マニフェストは短期キャッシュ
/favicon.ico
  Cache-Control: public, max-age=3600
/icon.png
  Cache-Control: public, max-age=3600
/manifest.json
  Cache-Control: public, max-age=3600

# robots.txt / llms.txt
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
